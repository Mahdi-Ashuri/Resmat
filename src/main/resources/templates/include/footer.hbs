<button type="button" class="to-top" id="haut" aria-label="Retour en haut"><svg class="ico"><use href="#i-up"/></svg></button>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
<script>
    // Dates ISO (2026-11-09T14:30) -> format français
    document.querySelectorAll('.dt').forEach(function (el) {
        var texte = el.textContent.trim();
        if (!texte) { el.textContent = '—'; return; }
        var d = new Date(texte);
        if (!isNaN(d)) {
            el.textContent = d.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
        }
    });

    // Année du footer
    document.getElementById('annee').textContent = new Date().getFullYear();

    // Initiales dans l'avatar
    document.querySelectorAll('.avatar[data-nom]').forEach(function (a) {
        var m = a.dataset.nom.trim().split(/\s+/);
        a.textContent = ((m[0] || '')[0] || '') + ((m[1] || '')[0] || '');
    });

    // Rôle affiché en clair
    var roles = { ADMIN: 'Administrateur', GESTIONNAIRE: 'Gestionnaire', EMPRUNTEUR: 'Emprunteur' };
    document.querySelectorAll('.role-label').forEach(function (el) {
        var r = el.textContent.trim();
        if (roles[r]) el.textContent = roles[r];
    });

    // Lien actif : menu, sous-menu et onglets
    var chemin = location.pathname, complet = location.pathname + location.search;
    function actif(h) { return h === '/' ? chemin === '/' : (h && h !== '#' && chemin.indexOf(h) === 0); }
    document.querySelectorAll('.navbar .nav-link:not(.dropdown-toggle)').forEach(function (a) {
        if (actif(a.getAttribute('href'))) a.classList.add('active');
    });
    document.querySelectorAll('.navbar .dropdown-item').forEach(function (a) {
        if (actif(a.getAttribute('href'))) {
            a.classList.add('active');
            var t = a.closest('.dropdown').querySelector('.dropdown-toggle');
            if (t) t.classList.add('active');
        }
    });
    document.querySelectorAll('.nav-pills .nav-link').forEach(function (a) {
        if (a.getAttribute('href') === complet) a.classList.add('active');
    });

    // Apparition au défilement
    var items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
            });
        }, { threshold: 0.12 });
        items.forEach(function (el) { obs.observe(el); });
    } else {
        items.forEach(function (el) { el.classList.add('in'); });
    }

    // Bouton retour en haut
    var haut = document.getElementById('haut');
    window.addEventListener('scroll', function () {
        haut.classList.toggle('show', window.scrollY > 400);
    }, { passive: true });
    haut.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
</script>
