{{> include/header }}

<h1 class="h3 mb-4">{{titre}}</h1>

{{#materiel}}
<form action="/materiels/enregistrer"
      method="post"
      enctype="multipart/form-data"
      class="col-md-6">

    <input type="hidden" name="idMateriel" value="{{idMateriel}}">

    <div class="mb-3">
        <label for="nom" class="form-label">Nom</label>
        <input type="text"
               class="form-control"
               id="nom"
               name="nom"
               value="{{nom}}"
               maxlength="150"
               required>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control"
                  id="description"
                  name="description"
                  rows="4">{{description}}</textarea>
    </div>

    <div class="mb-3">
        <label for="typeMateriel" class="form-label">
            Type de matériel
        </label>

        <select class="form-select"
                id="typeMateriel"
                name="typeMateriel.idTypeMateriel"
                required>

            <option value="">Choisir un type…</option>

            {{#typesOptions}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>
                {{label}}
            </option>
            {{/typesOptions}}

        </select>
    </div>

    <div class="mb-3">
        <label for="fichierPhoto" class="form-label">
            Photo
        </label>

        {{#photo}}
        <div class="mb-2">
            <img src="/photos/{{.}}"
                 alt="Photo du matériel"
                 class="img-thumbnail"
                 style="max-height:150px">
        </div>

        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="supprimerPhoto"
                   name="supprimerPhoto"
                   value="true">

            <label class="form-check-label"
                   for="supprimerPhoto">
                Supprimer la photo actuelle
            </label>
        </div>
        {{/photo}}

        <input type="file"
               class="form-control"
               id="fichierPhoto"
               name="fichierPhoto"
               accept="image/jpeg,image/png">

        <div class="form-text">
            JPEG ou PNG, 5 Mo maximum.
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input"
               type="checkbox"
               id="disponible"
               name="disponible"
               value="true"
               {{#disponible}}checked{{/disponible}}>

        <label class="form-check-label"
               for="disponible">
            Disponible
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Enregistrer
    </button>

    <a href="/materiels"
       class="btn btn-outline-secondary">
        Annuler
    </a>

</form>
{{/materiel}}

{{> include/footer }}