{{> include/header }}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Matériels</h1>
    <a href="/materiels/nouveau" class="btn btn-dark">Ajouter un matériel</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Nom</th>
            <th>Type</th>
            <th>Disponibilité</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        {{#materiels}}
        <tr>
            <td>{{idMateriel}}</td>
            <td>
                {{nom}}
                <div class="small text-muted">{{description}}</div>
            </td>
            <td>{{typeMateriel.nom}}</td>
            <td>
                {{#disponible}}<span class="badge bg-success">Disponible</span>{{/disponible}}
                {{^disponible}}<span class="badge bg-danger">Indisponible</span>{{/disponible}}
            </td>
            <td class="text-end">
                <a href="/materiels/{{idMateriel}}/modifier" class="btn btn-secondary btn-sm">Modifier</a>
                <form action="/materiels/{{idMateriel}}/supprimer" method="post" class="d-inline"
                      onsubmit="return confirm('Supprimer ce matériel ?');">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                </form>
            </td>
        </tr>
        {{/materiels}}
    </tbody>
</table>

{{^materiels}}
<div class="alert alert-warning" role="alert">Aucun matériel.</div>
{{/materiels}}

{{> include/footer }}