{{> include/header }}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Matériels</h1>

    {{#peutGerer}}
    <a href="/materiels/nouveau"
       class="btn btn-dark">
       Ajouter un matériel
    </a>
    {{/peutGerer}}
</div>
<form action="/materiels" method="get" class="input-group mb-3">
    <input type="search" class="form-control" name="motCle" value="{{motCle}}"
           placeholder="Rechercher par mot clé (nom, description, type)" maxlength="100"
           aria-label="Rechercher un matériel">
    <button type="submit" class="btn btn-dark">Rechercher</button>
    {{#rechercheActive}}
    <a href="/materiels" class="btn btn-outline-secondary">Réinitialiser</a>
    {{/rechercheActive}}
</form>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Photo</th>
            <th>Nom</th>
            <th>Type</th>
            <th>Disponibilité</th>
            {{#peutGerer}}
            <th class="text-end">Actions</th>
            {{/peutGerer}}
        </tr>
    </thead>

    <tbody>

        {{#materiels}}
        <tr>

            <td>{{idMateriel}}</td>

            <td style="width:90px">

                {{#photo}}
                <img src="/photos/{{.}}"
                     alt="Photo"
                     class="img-thumbnail"
                     style="max-height:60px">
                {{/photo}}

                {{^photo}}
                <span class="text-muted small">—</span>
                {{/photo}}

            </td>

            <td>
                {{nom}}
                <div class="small text-muted">
                    {{description}}
                </div>
            </td>

            <td>{{typeMateriel.nom}}</td>

            <td>
                {{#disponible}}
                <span class="badge bg-success">
                    Disponible
                </span>
                {{/disponible}}

                {{^disponible}}
                <span class="badge bg-danger">
                    Indisponible
                </span>
                {{/disponible}}
            </td>

            {{#peutGerer}}
            <td class="text-end">

                <a href="/materiels/{{idMateriel}}/modifier"
                   class="btn btn-secondary btn-sm">
                    Modifier
                </a>

                <form action="/materiels/{{idMateriel}}/supprimer"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Supprimer ce matériel ?');">

                    <button type="submit"
                            class="btn btn-danger btn-sm">
                        Supprimer
                    </button>

                </form>

            </td>
            {{/peutGerer}}

        </tr>
        {{/materiels}}

    </tbody>
</table>

{{^materiels}}
<div class="alert alert-warning" role="alert">
    Aucun matériel.
</div>
{{/materiels}}

{{> include/footer }}