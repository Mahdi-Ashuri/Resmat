{{> include/header }}

<h1 class="h3 mb-4">{{titre}}</h1>

{{#typeMateriel}}
<form action="/types-materiel/enregistrer" method="post" class="col-md-6">
    <input type="hidden" name="idTypeMateriel" value="{{idTypeMateriel}}">

    <div class="mb-3">
        <label for="nom" class="form-label">Nom</label>
        <input type="text" class="form-control" id="nom" name="nom" value="{{nom}}" maxlength="150" required>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="4">{{description}}</textarea>
    </div>

    <div class="mb-3">
        <label for="dureeMaxEmprunt" class="form-label">Durée maximale d'emprunt (en jours)</label>
        <input type="number" class="form-control" id="dureeMaxEmprunt" name="dureeMaxEmprunt" value="{{dureeMaxEmprunt}}" min="1" required>
    </div>

    <div class="mb-3">
        <label for="categorie" class="form-label">Catégorie</label>
        <select class="form-select" id="categorie" name="categorie.idCategorie" required>
            <option value="">Choisir une catégorie…</option>
            {{#categoriesOptions}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/categoriesOptions}}
        </select>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="auCatalogue" name="auCatalogue" value="true" {{#auCatalogue}}checked{{/auCatalogue}}>
        <label class="form-check-label" for="auCatalogue">Visible au catalogue (réservable)</label>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a href="/types-materiel" class="btn btn-outline-secondary">Annuler</a>
</form>
{{/typeMateriel}}

{{> include/footer }}