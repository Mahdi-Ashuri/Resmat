{{> include/header }}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Types de matériel</h1>
    <a href="/types-materiel/nouveau" class="btn btn-dark">Ajouter un type</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Nom</th>
            <th>Catégorie</th>
            <th>Durée max (jours)</th>
            <th>Catalogue</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        {{#typesMateriel}}
        <tr>
            <td>{{idTypeMateriel}}</td>
            <td>
                {{nom}}
                <div class="small text-muted">{{description}}</div>
            </td>
            <td>{{categorie.nom}}</td>
            <td>{{dureeMaxEmprunt}}</td>
            <td>
                {{#auCatalogue}}<span class="badge bg-success">Oui</span>{{/auCatalogue}}
                {{^auCatalogue}}<span class="badge bg-secondary">Non</span>{{/auCatalogue}}
            </td>
            <td class="text-end">
                <a href="/types-materiel/{{idTypeMateriel}}/modifier" class="btn btn-secondary btn-sm">Modifier</a>
                <form action="/types-materiel/{{idTypeMateriel}}/supprimer" method="post" class="d-inline"
                      onsubmit="return confirm('Supprimer ce type de matériel ?');">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                </form>
            </td>
        </tr>
        {{/typesMateriel}}
    </tbody>
</table>

{{^typesMateriel}}
<div class="alert alert-warning" role="alert">Aucun type de matériel.</div>
{{/typesMateriel}}

{{> include/footer }}